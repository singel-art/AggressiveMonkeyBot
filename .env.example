# Modele de configuration. Copier ce fichier sous le nom ".env" et le completer.
# Le fichier .env n'est jamais versionne (voir .gitignore). Ne mettez AUCUNE vraie
# valeur dans ce modele.
#
# Les variables d'environnement du systeme priment sur ce fichier.

# Cle de l'API du Bureau of Labor Statistics (gratuite, sur inscription).
# Recommandee : sans cle, le quota journalier est tres vite atteint.
BLS_API_KEY=

# Cle de l'API FRED (gratuite). Prevue, pas encore utilisee par le code.
FRED_API_KEY=

# Politique temporelle des lectures : balanced (defaut, decision du projet), strict ou estimate.
AMB_TEMPORAL_POLICY=

# Dossier des donnees collectees. Vide = dossier "data" a la racine du depot.
AMB_DATA_DIR=
